<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud backup and device-transfer rules for Android 12 (API 31) and higher.
  allowBackup is false, so these rules are unused unless that flag is turned
  back on. They still exclude the census database (precise location, observer
  IDs) as defense in depth.

  See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="observations_database" />
        <exclude domain="database" path="observations_database-journal" />
        <exclude domain="database" path="observations_database-shm" />
        <exclude domain="database" path="observations_database-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="observations_database" />
        <exclude domain="database" path="observations_database-journal" />
        <exclude domain="database" path="observations_database-shm" />
        <exclude domain="database" path="observations_database-wal" />
    </device-transfer>
</data-extraction-rules>
